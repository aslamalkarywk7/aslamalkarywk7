# Copy this file to `.env` and fill in your key.
# `.env` is git-ignored — the key must never be committed or shipped to the browser.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: override the model (defaults to the stable llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: port for the local dev server
# PORT=3000
